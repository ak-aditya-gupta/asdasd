{
  "name": "UPPCL Blocker & Tracker",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["declarativeNetRequest", "tabs"],
  "host_permissions": ["*://ewallet.uppclonline.com/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ruleset_1", "enabled": true, "path": "rules.json" }]
  }
}